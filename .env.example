# =================================================================
#  Journal TDAH — variables d'environnement
# =================================================================
# Copier ce fichier vers .env.local pour le dev.
# En production, configurer ces valeurs dans Vercel → Settings → Environment Variables.
# Ne JAMAIS commit .env.local. Ne JAMAIS partager ces valeurs en clair.
# =================================================================

# --- Base de données (Neon Postgres, région eu-central-1 / Frankfurt) ---
# Console : https://console.neon.tech → projet → Connection Details → Pooled connection
DATABASE_URL=

# --- Auth (Better Auth) ---
# Générer une clé de 32+ octets. En CLI :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Chiffrement applicatif des champs longs (RGPD art. 9) ---
# Générer une clé de 32 octets EXACTEMENT (256 bits pour AES-256).
#   openssl rand -base64 32
ENCRYPTION_KEY=

# --- Email (Resend) ---
# https://resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="Journal TDAH <hello@mail.symbiose-psychologie.com>"

# --- Webhook Podia ---
# Choisi librement, à configurer côté Podia → Settings → Webhooks
PODIA_WEBHOOK_SECRET=

# --- Stockage de blobs (Vercel Blob, pour exports RGPD) ---
# Vercel Dashboard → Storage → Blob → Connect Project
BLOB_READ_WRITE_TOKEN=

# --- Sentry (monitoring d'erreurs, PII filtering activé) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Dev only : galerie de composants /dev/components ---
# Mettre à 1 pour activer la page galerie en local. JAMAIS en prod.
NEXT_PUBLIC_DEV_GALLERY=0
